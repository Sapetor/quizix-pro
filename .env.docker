# Quizix Pro Docker Environment Configuration
# Copy this file to .env and adjust values for your environment.
# Only variables the server actually reads are listed here; see .env.example
# for the full annotated list.

# ===========================================
# Application Configuration
# ===========================================
NODE_ENV=production
PORT=3000

# Base path for routing (standalone Docker: /, K8s ingress: /quizix/)
BASE_PATH=/

# ===========================================
# Public access (reverse proxy / tunnel)
# ===========================================
# Public URL clients reach. Without it the QR code and join links fall back to
# the container's detected IP, which is unreachable from outside.
# PUBLIC_ORIGIN=https://quiz.example.com

# Exact CORS allow-list (comma-separated). Setting this drops the built-in
# cloud-platform wildcards. Must include PUBLIC_ORIGIN or Socket.IO rejects it.
# ALLOWED_ORIGINS=https://quiz.example.com

# Comma-separated proxy IPs whose forwarded client-IP headers are trusted.
# Behind a docker bridge this is the bridge gateway (e.g. 172.17.0.1).
# TRUSTED_PROXY_IPS=

# Manual network IP override (skips auto-detection)
# NETWORK_IP=

# ===========================================
# Security
# ===========================================
# Session secret (must be >= 32 chars, else ignored). If unset, one is
# generated and persisted at quizzes/.session-secret.
# SESSION_SECRET=

# Account signup gate. The first account on a fresh instance can always be
# created; once any account exists, POST /api/auth/signup returns 403 unless
# this is exactly "true".
# ALLOW_SIGNUP=false

# Opt-in switch for /metrics, /debug/config, /api/debug/files and
# /api/debug/directory. All four are unauthenticated. MUST STAY UNSET IN
# PRODUCTION. It gates development runs too: these used to be reachable on any
# run without NODE_ENV=production. /health and /ready are not gated, so the
# container healthcheck still works.
# ENABLE_DEBUG_ROUTES=false

# ===========================================
# Optional subsystems (off by default)
# ===========================================
OLLAMA_ENABLED=false
OLLAMA_URL=http://localhost:11434

MANIM_ENABLED=false
# MANIM_VENV_PATH=/opt/manim-env
# MANIM_RENDER_TIMEOUT=120

# ===========================================
# AI generation (optional)
# ===========================================
# CLAUDE_API_KEY=
# CLAUDE_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
