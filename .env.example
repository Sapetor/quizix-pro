# Environment Configuration for Quizix Pro

# Node environment (development, production)
NODE_ENV=development

# Base path for application routing
# Local development / standalone Docker: BASE_PATH=/
# Kubernetes deployment: BASE_PATH=/quizix/
BASE_PATH=/

# Optional: Manual network IP override (useful for WSL)
# If not set, the server will auto-detect your local network IP
# Example: NETWORK_IP=192.168.1.100
# NETWORK_IP=

# Optional: Public origin, when reached through a reverse tunnel or proxy
# (cloudflared, ngrok). Without it the QR code and join links fall back to the
# detected LAN IP, which is unreachable for anyone off the local network.
# Pair it with ALLOWED_ORIGINS or Socket.IO CORS will reject the same hostname.
# Example: PUBLIC_ORIGIN=https://quiz.example.uk
# PUBLIC_ORIGIN=

# Optional: Exact CORS allow-list (comma-separated). Setting this drops the
# built-in cloud-platform wildcards (vercel/netlify/herokuapp/...), fail-closed.
# Example: ALLOWED_ORIGINS=https://quiz.example.uk
# ALLOWED_ORIGINS=

# Optional: Custom port (default: 3000)
# PORT=3000

# AI Integration Settings
# Optional: Server-side Claude API key (recommended for production)
# If set, this key is used instead of client-provided keys
# This is more secure as the key never leaves the server
# CLAUDE_API_KEY=sk-ant-xxxxx

# Optional: Override default Claude model
# CLAUDE_MODEL=claude-sonnet-4-5
