# Environment Configuration for Quizix Pro
#
# Copy to .env and adjust. Every variable below is read by the server; the list
# is derived from `grep -r "process\.env\." server.js services routes socket
# utils middleware config`. Anything not listed here is not read by the app.
#
# All values are strings. Boolean flags are compared against the exact literal
# "true". Any other value (including "1", "yes", "TRUE") counts as false.

# ===========================================
# Application
# ===========================================

# development | production. Production also selects the stricter CORS defaults
# and the production BASE_PATH fallback.
NODE_ENV=development

# HTTP port the server listens on (default 3000).
# PORT=3000

# Base path for application routing. MUST start with "/" or startup fails.
# Local development / standalone Docker: BASE_PATH=/
# Kubernetes behind the ingress:         BASE_PATH=/quizix/
# If unset, production defaults to /quizix/, so set it explicitly for any
# standalone deploy served at the root.
BASE_PATH=/

# ===========================================
# Network / public access
# ===========================================

# Manual network IP override (useful on WSL, where auto-detection picks the
# virtual adapter). If unset, the server auto-detects the LAN IP and uses it
# for the join URL and QR code.
# NETWORK_IP=192.168.1.100

# Public URL clients actually reach, when the server sits behind a reverse
# proxy or tunnel (cloudflared, ngrok, k8s ingress). Without it the QR code and
# join links fall back to the detected container/LAN IP, which is unreachable
# from outside that network (services/qr-service.js).
# Pair it with ALLOWED_ORIGINS or Socket.IO CORS rejects the same hostname.
# PUBLIC_ORIGIN=https://quiz.example.com

# Exact CORS allow-list, comma-separated. Setting this at all drops the
# built-in cloud-platform wildcards (vercel/netlify/herokuapp/...), i.e. it is
# fail-closed. Invalid entries are logged and skipped.
# ALLOWED_ORIGINS=https://quiz.example.com,https://alt.example.com

# Comma-separated source addresses whose CF-Connecting-IP header is trusted
# (middleware/client-ip.js). Loopback (127.0.0.1, ::1) is always trusted.
# Set this whenever the proxy does NOT reach the app over loopback:
#   docker bridge    -> the bridge gateway, e.g. 172.17.0.1
#   Kubernetes       -> the ingress controller pod IP / pod CIDR
# Leaving it unset behind such a proxy makes every request appear to come from
# the proxy, so all per-IP rate limits collapse into one shared bucket.
# TRUSTED_PROXY_IPS=172.17.0.1

# ===========================================
# Security
# ===========================================

# Express session secret. Must be at least 32 characters or it is ignored.
# If unset, one is generated and persisted at quizzes/.session-secret.
# SESSION_SECRET=

# Opt-in switch for four unauthenticated diagnostic endpoints:
#   /metrics             full Prometheus process metrics
#   /debug/config        BASE_PATH / environment dump
#   /api/debug/files     filesystem inspection
#   /api/debug/directory directory listing
# MUST STAY UNSET IN PRODUCTION: anyone who can reach the port can read them.
#
# This now gates DEVELOPMENT runs too. /metrics and /debug/config used to be
# registered unconditionally, and the two /api/debug routes were gated on
# NODE_ENV !== 'production', and `npm start` sets no NODE_ENV, so an ordinary
# LAN run exposed all four. If you were using any of them locally, set this to
# "true" in your own .env; nothing else re-enables them.
#
# /health and /ready are NOT gated, so container healthchecks and Kubernetes
# liveness/readiness probes are unaffected.
# ENABLE_DEBUG_ROUTES=false

# ===========================================
# Capacity
# ===========================================

# "true" applies the reduced limits in config/limits.js: 5 concurrent games,
# 50 players per game, 1 MB uploads (desktop defaults are higher).
# MOBILE_MODE=false

# ===========================================
# Optional subsystems (off by default)
# ===========================================

# Local Ollama question generation. Only "true" enables it.
# OLLAMA_ENABLED=false
# OLLAMA_URL=http://localhost:11434

# Manim animation rendering. Opt-in only: the Python denylist is not a sandbox,
# so enabling this allows operator-supplied code execution on the server.
# MANIM_ENABLED=false
# Path to the Manim virtualenv (default: ~/manim-env)
# MANIM_VENV_PATH=/opt/manim-env
# Per-render timeout in MILLISECONDS (default: 60000)
# MANIM_RENDER_TIMEOUT=120000

# ===========================================
# AI question generation (optional)
# ===========================================

# Server-side keys. Recommended for production: the key never leaves the
# server, and a server-side key takes precedence over a client-supplied one.
# CLAUDE_API_KEY=sk-ant-xxxxx
# GEMINI_API_KEY=

# Model overrides (defaults: claude-sonnet-4-5 / gemini-2.5-flash)
# CLAUDE_MODEL=claude-sonnet-4-5
# GEMINI_MODEL=gemini-2.5-flash

# ===========================================
# Read but never set by you
# ===========================================
# VERCEL_ENV and HEROKU_APP_NAME are injected by those platforms; qr-service
# only checks whether they are present, to pick the cloud join-URL branch.
